# L1 Ethereum RPC endpoint — REQUIRED. Nitro will not start without it.
# Use your local Ethereum node (recommended once synced) or an external provider.
# With network_mode: host, the local eth node is reachable on 127.0.0.1.
L1_RPC_URL=http://127.0.0.1:8555

# L1 Beacon (consensus) API — OPTIONAL. Nitro needs a beacon endpoint to read
# blobs. Defaults to PublicNode if unset. Point it at your own Lighthouse
# (http://127.0.0.1:5052) once that node is synced.
#L1_BEACON_URL=http://127.0.0.1:5052

# Where chain data lives on the host — OPTIONAL, defaults to /data/rpc_nodes.
#DATA_ROOT=/data/rpc_nodes
