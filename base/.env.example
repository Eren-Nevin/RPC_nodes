# --- Required ---
# L1 Ethereum execution RPC (your local eth-reth, or an external provider).
BASE_NODE_L1_ETH_RPC=http://127.0.0.1:8555

# --- Optional: initial sync from an old snapshot ---
# During the first catch-up from a snapshot, the local L1 lighthouse may not have
# the data columns to reconstruct the blobs the op-node needs (see README §Blobs).
# Point the beacon at a blob-archive endpoint until Base is caught up, then remove
# this line and recreate the node so it uses the local supernode lighthouse.
# BASE_NODE_L1_BEACON=https://ethereum-beacon-api.publicnode.com
