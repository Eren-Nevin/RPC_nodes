#!/usr/bin/env bash
# download-snapshot — download and extract blockchain node snapshots
#
# Usage:
#   ./download-snapshot -n <node> [-t full|pruned] [-x] [-d <data-root>]
#
# Options:
#   -n  Node name (required): eth | arb | base | polygon | bsc | tron
#   -t  Snapshot type: full (default) | pruned
#   -x  Extract-only mode: scan data dir for already-downloaded files and extract them
#   -d  Override data root (default: /data/rpc_nodes)
#   -h  Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── defaults ─────────────────────────────────────────────────────────────────
NODE=""
TYPE="full"
EXTRACT_ONLY=false
DATA_ROOT="/data/rpc_nodes"

# ─── usage ────────────────────────────────────────────────────────────────────
usage() {
  grep '^#' "$0" | sed 's/^# \?//' | head -20
  exit "${1:-0}"
}

# ─── argument parsing ─────────────────────────────────────────────────────────
while getopts "n:t:xd:h" opt; do
  case "$opt" in
    n) NODE="$OPTARG" ;;
    t) TYPE="$OPTARG" ;;
    x) EXTRACT_ONLY=true ;;
    d) DATA_ROOT="$OPTARG" ;;
    h) usage 0 ;;
    *) usage 1 ;;
  esac
done

# ─── validate args ────────────────────────────────────────────────────────────
if [[ -z "$NODE" ]]; then
  echo "ERROR: -n <node> is required (eth | arb | base | polygon | bsc | tron | bitcoin)" >&2
  usage 1
fi

case "$NODE" in
  eth|arb|base|polygon|bsc|tron|bitcoin) ;;
  *) echo "ERROR: Unknown node '${NODE}'. Must be one of: eth arb base polygon bsc tron bitcoin" >&2; exit 1 ;;
esac

case "$TYPE" in
  full|pruned) ;;
  *) echo "ERROR: Unknown type '${TYPE}'. Must be full or pruned." >&2; exit 1 ;;
esac

# ─── root check ──────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
  echo "ERROR: This script must be run as root (writes to ${DATA_ROOT} and sets ownership)." >&2
  echo "       Re-run with: sudo $0 $*" >&2
  exit 1
fi

# ─── tool checks ─────────────────────────────────────────────────────────────
check_tool() {
  if ! command -v "$1" &>/dev/null; then
    echo "ERROR: Required tool '$1' is not installed." >&2
    exit 1
  fi
}

check_tool aria2c
check_tool zstd
check_tool lz4

# ─── helpers ──────────────────────────────────────────────────────────────────
download() {
  local url="$1"
  local dest_dir="$2"
  local filename
  filename="$(basename "$url")"
  echo "==> Downloading: $url"
  echo "    → ${dest_dir}/${filename}"
  aria2c -x 16 -s 16 --file-allocation=none \
    --continue=true \
    -d "$dest_dir" \
    "$url"
}

download_limited() {
  local url="$1"
  local dest_dir="$2"
  local filename
  filename="$(basename "$url")"
  echo "==> Downloading (2 connections): $url"
  echo "    → ${dest_dir}/${filename}"
  aria2c -x 2 -s 2 --file-allocation=none \
    --continue=true \
    -d "$dest_dir" \
    "$url"
}

extract_zst() {
  local file="$1"
  local dest="$2"
  echo "==> Extracting (zstd): $file → $dest"
  mkdir -p "$dest"
  zstd -d --long=31 --stdout "$file" | tar -xf - -C "$dest"
}

extract_tgz() {
  local file="$1"
  local dest="$2"
  local strip="${3:-0}"
  echo "==> Extracting (tgz, strip=$strip): $file → $dest"
  mkdir -p "$dest"
  tar -xzf "$file" -C "$dest" --strip-components="$strip"
}

extract_lz4() {
  local file="$1"
  local dest="$2"
  echo "==> Extracting (lz4): $file → $dest"
  mkdir -p "$dest"
  lz4 -dc "$file" | tar -xf - -C "$dest"
}

extract_lz4_strip() {
  # Extract lz4 tar, auto-detecting strip-components to place geth/ at dest root.
  # bnb-chain PBSS snapshots have variable path prefixes before geth/.
  local file="$1"
  local dest="$2"
  echo "==> Extracting (lz4, auto-strip): $file → $dest"
  mkdir -p "$dest"

  # Find how deep the geth/ dir is inside the tar
  local geth_path
  geth_path="$(lz4 -dc "$file" | tar -tf - 2>/dev/null | grep -m1 'geth/chaindata/' || true)"

  local strip=0
  if [[ -n "$geth_path" ]]; then
    # Count path components before "geth/"
    local prefix="${geth_path%%geth/*}"
    if [[ -n "$prefix" ]]; then
      strip="$(echo "$prefix" | tr -cd '/' | wc -c)"
    fi
  fi

  echo "    strip-components=$strip"
  lz4 -dc "$file" | tar -xf - -C "$dest" --strip-components="$strip"
}

fix_ownership() {
  local dir="$1"
  echo "==> Fixing ownership (1000:1000): $dir"
  chown -R 1000:1000 "$dir"
}

# ─── per-chain logic ──────────────────────────────────────────────────────────

# ── ETH ───────────────────────────────────────────────────────────────────────
do_eth() {
  if [[ "$TYPE" == "pruned" ]]; then
    echo "ERROR: eth only supports 'full' snapshots (ethPandaOps archive)." >&2
    exit 1
  fi

  local dest="${DATA_ROOT}/eth-data"
  local extract_to="${DATA_ROOT}/eth-data/reth"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest" -maxdepth 1 -name "*.tar.zst" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No *.tar.zst files found in $dest" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_zst "$f" "$extract_to"
    done
    fix_ownership "$extract_to"
    return
  fi

  echo "==> Resolving latest ethPandaOps Reth snapshot ..."
  local latest
  latest="$(curl -sSfL https://snapshots.ethpandaops.io/mainnet/reth/latest)"
  local url="https://snapshots.ethpandaops.io/mainnet/reth/${latest}/snapshot.tar.zst"
  echo "==> Resolved: $url"

  mkdir -p "$extract_to"
  download "$url" "$dest"

  echo "==> Extracting ..."
  extract_zst "${dest}/snapshot.tar.zst" "$extract_to"
  fix_ownership "$extract_to"
}

# ── ARB ───────────────────────────────────────────────────────────────────────
do_arb() {
  if [[ "$TYPE" == "pruned" ]]; then
    echo "ERROR: arb only supports 'full' snapshots (PublicNode provides full archive)." >&2
    exit 1
  fi

  local dest="${DATA_ROOT}/arbitrum"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest" -maxdepth 1 -name "*.tar.lz4" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No *.tar.lz4 files found in $dest" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_lz4 "$f" "$dest"
    done
    fix_ownership "$dest"
    return
  fi

  # Try to auto-discover from publicnode.com
  echo "==> Attempting auto-discovery of Arbitrum snapshots from publicnode.com ..."
  local base_url="" part_url=""

  local listing
  listing="$(curl -sSf "https://publicnode.com/snapshots" 2>/dev/null || true)"

  if [[ -n "$listing" ]]; then
    base_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/arbitrum-base-[0-9]+-[0-9]+\.tar\.lz4' | head -1 || true)"
    part_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/arbitrum-part-[0-9]+-[0-9]+\.tar\.lz4' | head -1 || true)"
  fi

  # Fallback: parse snapshot-urls.txt
  if [[ -z "$base_url" || -z "$part_url" ]]; then
    echo "==> Auto-discovery incomplete, falling back to arbitrum/snapshot-urls.txt ..."
    local urls_file="${SCRIPT_DIR}/arbitrum/snapshot-urls.txt"
    if [[ ! -f "$urls_file" ]]; then
      echo "ERROR: $urls_file not found and auto-discovery failed." >&2
      exit 1
    fi
    if [[ -z "$base_url" ]]; then
      base_url="$(grep -oE 'https://snapshots\.publicnode\.com/arbitrum-base-[0-9]+-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
    if [[ -z "$part_url" ]]; then
      part_url="$(grep -oE 'https://snapshots\.publicnode\.com/arbitrum-part-[0-9]+-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
  fi

  if [[ -z "$base_url" || -z "$part_url" ]]; then
    echo "ERROR: Could not resolve Arbitrum snapshot URLs." >&2
    echo "  base : ${base_url:-<not found>}" >&2
    echo "  part : ${part_url:-<not found>}" >&2
    echo "Update arbitrum/snapshot-urls.txt with current publicnode.com URLs." >&2
    exit 1
  fi

  echo "==> Resolved URLs:"
  echo "    base : $base_url"
  echo "    part : $part_url"

  mkdir -p "$dest"
  download "$base_url" "$dest"
  download "$part_url" "$dest"

  # Resolve actual filenames on disk (PublicNode may rotate URLs mid-download)
  local base_file part_file
  base_file="$(ls -t "${dest}"/arbitrum-base-*.tar.lz4 2>/dev/null | head -1)"
  part_file="$(ls -t "${dest}"/arbitrum-part-*.tar.lz4 2>/dev/null | head -1)"

  if [[ -z "$base_file" || -z "$part_file" ]]; then
    echo "ERROR: Could not find all downloaded snapshot files in $dest" >&2
    echo "  base : ${base_file:-<not found>}" >&2
    echo "  part : ${part_file:-<not found>}" >&2
    exit 1
  fi

  echo "==> Extracting base snapshot ..."
  extract_lz4 "$base_file" "$dest"

  echo "==> Extracting incremental snapshot ..."
  extract_lz4 "$part_file" "$dest"

  fix_ownership "$dest"
}

# ── BASE ──────────────────────────────────────────────────────────────────────
do_base() {
  local dest="${DATA_ROOT}/base-data"
  local extract_to="${DATA_ROOT}/base-data/reth"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest" -maxdepth 1 -name "*.tar.zst" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No *.tar.zst files found in $dest" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_zst "$f" "$extract_to"
    done
    fix_ownership "$extract_to"
    return
  fi

  local api_url base_url
  case "$TYPE" in
    full)
      base_url="https://mainnet-reth-archive-snapshots.base.org"
      api_url="${base_url}/latest"
      echo "==> Resolving latest Base archive (full) snapshot ..."
      ;;
    pruned)
      base_url="https://mainnet-reth-pruned-snapshots.base.org"
      api_url="${base_url}/latest"
      echo "==> Resolving latest Base full (pruned) snapshot ..."
      ;;
  esac

  local filename snapshot_url
  filename="$(curl -sSfL "$api_url")"
  snapshot_url="${base_url}/${filename}"
  echo "==> Resolved: $snapshot_url"

  mkdir -p "$extract_to"
  download "$snapshot_url" "$dest"

  echo "==> Extracting ..."
  extract_zst "${dest}/${filename}" "$extract_to"
  fix_ownership "$extract_to"
}

# ── POLYGON ───────────────────────────────────────────────────────────────────
do_polygon() {
  if [[ "$TYPE" == "pruned" ]]; then
    echo "ERROR: polygon only supports 'full' snapshots." >&2
    exit 1
  fi

  local dest="${DATA_ROOT}/polygon-data"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local heimdall_file bor_base_file bor_part_file
    heimdall_file="$(ls -t "${dest}"/polygon-heimdall-*.tar.lz4 2>/dev/null | head -1)"
    bor_base_file="$(ls -t "${dest}"/polygon-bor-base-*.tar.lz4 2>/dev/null | head -1)"
    bor_part_file="$(ls -t "${dest}"/polygon-bor-part-*.tar.lz4 2>/dev/null | head -1)"

    if [[ -z "$heimdall_file" || -z "$bor_base_file" || -z "$bor_part_file" ]]; then
      echo "ERROR: Could not find all snapshot files in $dest" >&2
      echo "  heimdall : ${heimdall_file:-<not found>}" >&2
      echo "  bor-base : ${bor_base_file:-<not found>}" >&2
      echo "  bor-part : ${bor_part_file:-<not found>}" >&2
      exit 1
    fi

    extract_lz4 "$heimdall_file" "${dest}/heimdall"
    extract_lz4 "$bor_base_file" "${dest}/bor"
    extract_lz4 "$bor_part_file" "${dest}/bor"
    fix_ownership "$dest"
    return
  fi

  # Try to auto-discover from publicnode.com/snapshots listing
  echo "==> Attempting auto-discovery of Polygon snapshots from publicnode.com ..."
  local heimdall_url="" bor_base_url="" bor_part_url=""

  local listing
  listing="$(curl -sSf "https://publicnode.com/snapshots" 2>/dev/null || true)"

  if [[ -n "$listing" ]]; then
    heimdall_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/polygon-heimdall-[0-9]+-[0-9]+\.tar\.lz4' | head -1 || true)"
    bor_base_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/polygon-bor-base-[0-9]+-[0-9]+\.tar\.lz4' | head -1 || true)"
    bor_part_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/polygon-bor-part-[0-9]+-[0-9]+\.tar\.lz4' | head -1 || true)"
  fi

  # Fallback: parse snapshot-urls.txt
  if [[ -z "$heimdall_url" || -z "$bor_base_url" || -z "$bor_part_url" ]]; then
    echo "==> Auto-discovery incomplete, falling back to polygon/snapshot-urls.txt ..."
    local urls_file="${SCRIPT_DIR}/polygon/snapshot-urls.txt"
    if [[ ! -f "$urls_file" ]]; then
      echo "ERROR: $urls_file not found and auto-discovery failed." >&2
      exit 1
    fi

    if [[ -z "$heimdall_url" ]]; then
      heimdall_url="$(grep -oE 'https://snapshots\.publicnode\.com/polygon-heimdall-[0-9]+-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
    if [[ -z "$bor_base_url" ]]; then
      bor_base_url="$(grep -oE 'https://snapshots\.publicnode\.com/polygon-bor-base-[0-9]+-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
    if [[ -z "$bor_part_url" ]]; then
      bor_part_url="$(grep -oE 'https://snapshots\.publicnode\.com/polygon-bor-part-[0-9]+-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
  fi

  if [[ -z "$heimdall_url" || -z "$bor_base_url" || -z "$bor_part_url" ]]; then
    echo "ERROR: Could not resolve all three Polygon snapshot URLs." >&2
    echo "  heimdall : ${heimdall_url:-<not found>}" >&2
    echo "  bor-base : ${bor_base_url:-<not found>}" >&2
    echo "  bor-part : ${bor_part_url:-<not found>}" >&2
    echo "Update polygon/snapshot-urls.txt with current publicnode.com URLs." >&2
    exit 1
  fi

  echo "==> Resolved URLs:"
  echo "    heimdall : $heimdall_url"
  echo "    bor-base : $bor_base_url"
  echo "    bor-part : $bor_part_url"

  mkdir -p "$dest"

  download "$heimdall_url" "$dest"
  download "$bor_base_url" "$dest"
  download "$bor_part_url" "$dest"

  # Resolve actual filenames on disk (PublicNode may rotate URLs mid-download)
  local heimdall_file bor_base_file bor_part_file
  heimdall_file="$(ls -t "${dest}"/polygon-heimdall-*.tar.lz4 2>/dev/null | head -1)"
  bor_base_file="$(ls -t "${dest}"/polygon-bor-base-*.tar.lz4 2>/dev/null | head -1)"
  bor_part_file="$(ls -t "${dest}"/polygon-bor-part-*.tar.lz4 2>/dev/null | head -1)"

  if [[ -z "$heimdall_file" || -z "$bor_base_file" || -z "$bor_part_file" ]]; then
    echo "ERROR: Could not find all downloaded snapshot files in $dest" >&2
    echo "  heimdall : ${heimdall_file:-<not found>}" >&2
    echo "  bor-base : ${bor_base_file:-<not found>}" >&2
    echo "  bor-part : ${bor_part_file:-<not found>}" >&2
    exit 1
  fi

  echo "==> Extracting Heimdall snapshot ..."
  extract_lz4 "$heimdall_file" "${dest}/heimdall"

  echo "==> Extracting Bor base snapshot ..."
  extract_lz4 "$bor_base_file" "${dest}/bor"

  echo "==> Extracting Bor incremental snapshot ..."
  extract_lz4 "$bor_part_file" "${dest}/bor"

  fix_ownership "$dest"
}

# ── BSC ────────────────────────────────────────────────────────────────────────
# full   = bnb-chain official PBSS snapshot (~5 TB, includes all history + logs)
# pruned = 48Club Geth full snapshot (~964 GB, recent state only, no log index)
do_bsc() {
  local dest="${DATA_ROOT}/bsc-data"
  local extract_to="${DATA_ROOT}/bsc-data/full"

  case "$TYPE" in
    full)   do_bsc_full "$dest" "$extract_to" ;;
    pruned) do_bsc_pruned "$dest" "$extract_to" ;;
  esac
}

do_bsc_full() {
  local dest="$1"
  local extract_to="$2"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest/download" -maxdepth 1 -name "mainnet-geth-pbss-*.tar.lz4" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No BSC PBSS *.tar.lz4 files found in $dest/download" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_lz4_strip "$f" "$extract_to"
    done
    fix_ownership "$extract_to"
    return
  fi

  # Resolve snapshot URLs from bsc/snapshot-urls.txt (bnb-chain official PBSS)
  local urls_file="${SCRIPT_DIR}/bsc/snapshot-urls.txt"
  local urls=()

  if [[ -f "$urls_file" ]]; then
    while IFS= read -r line; do
      urls+=("$line")
    done < <(grep -oE 'https://pub-[a-z0-9]+\.r2\.dev/mainnet-geth-pbss-[a-z]+-[0-9]+\.tar\.lz4' "$urls_file")
  fi

  if [[ ${#urls[@]} -eq 0 ]]; then
    echo "ERROR: Could not resolve BSC PBSS snapshot URLs." >&2
    echo "Update bsc/snapshot-urls.txt with the latest URLs from:" >&2
    echo "  https://github.com/bnb-chain/bsc-snapshots" >&2
    exit 1
  fi

  echo "==> Found ${#urls[@]} BSC PBSS snapshot files to download"

  mkdir -p "$dest/download" "$extract_to"

  for url in "${urls[@]}"; do
    download "$url" "$dest/download"
  done

  echo "==> Extracting all snapshot files ..."
  for url in "${urls[@]}"; do
    local filename
    filename="$(basename "$url")"
    local filepath="$dest/download/$filename"
    if [[ -f "$filepath" ]]; then
      extract_lz4_strip "$filepath" "$extract_to"
    else
      echo "WARN: Expected file not found: $filepath" >&2
    fi
  done

  fix_ownership "$extract_to"
}

do_bsc_pruned() {
  local dest="$1"
  local extract_to="$2"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest" -maxdepth 1 -name "geth.full.*.tar.zst" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No BSC Geth *.tar.zst files found in $dest" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_zst "$f" "$dest"
    done
    fix_ownership "$dest"
    return
  fi

  # Resolve snapshot URL from bsc/snapshot-urls.txt (48Club Geth)
  local urls_file="${SCRIPT_DIR}/bsc/snapshot-urls.txt"
  local url=""

  if [[ -f "$urls_file" ]]; then
    url="$(grep -oE 'https://complete\.snapshots\.48\.club/geth\.full\.[0-9]+\.tar\.zst' "$urls_file" | head -1 || true)"
  fi

  if [[ -z "$url" ]]; then
    echo "ERROR: Could not resolve BSC Geth snapshot URL." >&2
    echo "Update bsc/snapshot-urls.txt with the latest URL from:" >&2
    echo "  https://github.com/48Club/bsc-snapshots" >&2
    exit 1
  fi

  echo "==> Using BSC Geth pruned snapshot (48Club): $url"

  mkdir -p "$dest"
  download "$url" "$dest"

  local snapshot_file
  snapshot_file="$(ls -t "${dest}"/geth.full.*.tar.zst 2>/dev/null | head -1)"

  if [[ -z "$snapshot_file" ]]; then
    echo "ERROR: Could not find downloaded snapshot file in $dest" >&2
    exit 1
  fi

  echo "==> Extracting ..."
  extract_zst "$snapshot_file" "$dest"
  fix_ownership "$dest"
}

# ── TRON ──────────────────────────────────────────────────────────────────────
# full   = FullNode_output-directory.tgz     (~2.875 TB, downloaded then extracted)
# pruned = LiteFullNode_output-directory.tgz (~57 GB, downloaded then extracted)
do_tron() {
  local dest="${DATA_ROOT}/tron-data"
  local urls_file="${SCRIPT_DIR}/tron/snapshot-urls.txt"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done \
      < <(find "$dest" -maxdepth 1 -name "*.tgz" -print0 2>/dev/null)
    if [[ ${#found[@]} -eq 0 ]]; then
      echo "ERROR: No *.tgz files found in $dest" >&2
      exit 1
    fi
    for f in "${found[@]}"; do
      extract_tgz "$f" "$dest" 1
    done
    fix_ownership "$dest"
    return
  fi

  # Auto-discover latest backup dir from TRON Foundation servers.
  # Try multiple servers in order; first success wins.
  local servers=(
    "http://35.247.128.170"    # Singapore, LevelDB + internal txns
    "http://34.48.6.163"       # Americas, LevelDB + historical balances
    "http://34.143.247.77"     # Singapore, LevelDB
    "http://34.86.86.229"      # Americas, LevelDB
  )
  local full_url="" lite_url=""

  echo "==> Attempting auto-discovery of Tron snapshots from TRON Foundation servers ..."

  for server in "${servers[@]}"; do
    if [[ -n "$full_url" && -n "$lite_url" ]]; then
      break
    fi

    local listing
    listing="$(curl -sS --connect-timeout 10 "${server}/" 2>/dev/null || true)"
    if [[ -z "$listing" ]] || echo "$listing" | grep -q "404 Not Found"; then
      continue
    fi

    local latest_dir
    latest_dir="$(echo "$listing" | grep -oE 'backup[0-9]{8}' | sort -r | head -1 || true)"
    if [[ -z "$latest_dir" ]]; then
      continue
    fi

    echo "==> Found ${latest_dir} on ${server}"

    if [[ -z "$full_url" ]]; then
      # Verify the file actually exists with a HEAD request
      local candidate="${server}/${latest_dir}/FullNode_output-directory.tgz"
      local http_code
      http_code="$(curl -sS --connect-timeout 10 -o /dev/null -w '%{http_code}' --head "$candidate" 2>/dev/null || true)"
      if [[ "$http_code" == "200" ]]; then
        full_url="$candidate"
      fi
    fi

    if [[ -z "$lite_url" ]]; then
      local candidate="${server}/${latest_dir}/LiteFullNode_output-directory.tgz"
      local http_code
      http_code="$(curl -sS --connect-timeout 10 -o /dev/null -w '%{http_code}' --head "$candidate" 2>/dev/null || true)"
      if [[ "$http_code" == "200" ]]; then
        lite_url="$candidate"
      fi
    fi
  done

  # Fallback: parse tron/snapshot-urls.txt
  if [[ "$TYPE" == "full" && -z "$full_url" ]]; then
    echo "==> Auto-discovery failed for full, falling back to tron/snapshot-urls.txt ..."
    if [[ ! -f "$urls_file" ]]; then
      echo "ERROR: $urls_file not found and auto-discovery failed." >&2
      exit 1
    fi
    full_url="$(grep -oE 'http://[0-9.]+/backup[0-9]+/FullNode_output-directory\.tgz' "$urls_file" | head -1 || true)"
  fi

  if [[ "$TYPE" == "pruned" && -z "$lite_url" ]]; then
    echo "==> Auto-discovery failed for pruned, falling back to tron/snapshot-urls.txt ..."
    if [[ ! -f "$urls_file" ]]; then
      echo "ERROR: $urls_file not found and auto-discovery failed." >&2
      exit 1
    fi
    lite_url="$(grep -oE 'http://[0-9.]+/backup[0-9]+/LiteFullNode_output-directory\.tgz' "$urls_file" | head -1 || true)"
  fi

  mkdir -p "$dest"

  case "$TYPE" in
    full)
      if [[ -z "$full_url" ]]; then
        echo "ERROR: Could not resolve Tron full snapshot URL." >&2
        echo "Update tron/snapshot-urls.txt with the latest backup dir from ${full_server}/" >&2
        exit 1
      fi
      echo "==> Resolved full URL: $full_url"
      download_limited "$full_url" "$dest"
      local full_file
      full_file="$(ls -t "${dest}"/FullNode_output-directory.tgz 2>/dev/null | head -1)"
      if [[ -z "$full_file" ]]; then
        echo "ERROR: Could not find downloaded snapshot file in $dest" >&2
        exit 1
      fi
      extract_tgz "$full_file" "$dest" 1
      ;;
    pruned)
      if [[ -z "$lite_url" ]]; then
        echo "ERROR: Could not resolve Tron lite snapshot URL." >&2
        echo "Update tron/snapshot-urls.txt with the latest backup dir from ${lite_server}/" >&2
        exit 1
      fi
      echo "==> Resolved lite URL: $lite_url"
      download_limited "$lite_url" "$dest"
      local snapshot_file
      snapshot_file="$(ls -t "${dest}"/LiteFullNode_output-directory.tgz 2>/dev/null | head -1)"
      if [[ -z "$snapshot_file" ]]; then
        echo "ERROR: Could not find downloaded snapshot file in $dest" >&2
        exit 1
      fi
      extract_tgz "$snapshot_file" "$dest" 1
      ;;
  esac

  fix_ownership "$dest"
}

# ── Bitcoin ─────────────────────────────────────────────────────────────────────
# PublicNode provides Bitcoin snapshots as base + incremental lz4 tars.
do_bitcoin() {
  local dest="${DATA_ROOT}/bitcoin-data"

  if [[ "$EXTRACT_ONLY" == true ]]; then
    local base_file part_file
    base_file="$(ls -t "${dest}"/bitcoin-base*.tar.lz4 2>/dev/null | head -1)"
    part_file="$(ls -t "${dest}"/bitcoin-part-*.tar.lz4 2>/dev/null | head -1)"

    if [[ -z "$base_file" || -z "$part_file" ]]; then
      echo "ERROR: Could not find all snapshot files in $dest" >&2
      echo "  base : ${base_file:-<not found>}" >&2
      echo "  part : ${part_file:-<not found>}" >&2
      exit 1
    fi

    extract_lz4 "$base_file" "$dest"
    extract_lz4 "$part_file" "$dest"
    fix_ownership "$dest"
    return
  fi

  # Try to auto-discover from publicnode.com/snapshots listing
  echo "==> Attempting auto-discovery of Bitcoin snapshots from publicnode.com ..."
  local base_url="" part_url=""

  local listing
  listing="$(curl -sSf "https://publicnode.com/snapshots" 2>/dev/null || true)"

  if [[ -n "$listing" ]]; then
    base_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/bitcoin-base[^"]*\.tar\.lz4' | head -1 || true)"
    part_url="$(echo "$listing" | grep -oE 'https://snapshots\.publicnode\.com/bitcoin-part-[0-9]+\.tar\.lz4' | head -1 || true)"
  fi

  # Fallback: parse snapshot-urls.txt
  if [[ -z "$base_url" || -z "$part_url" ]]; then
    echo "==> Auto-discovery incomplete, falling back to bitcoin/snapshot-urls.txt ..."
    local urls_file="${SCRIPT_DIR}/bitcoin/snapshot-urls.txt"
    if [[ ! -f "$urls_file" ]]; then
      echo "ERROR: $urls_file not found and auto-discovery failed." >&2
      exit 1
    fi

    if [[ -z "$base_url" ]]; then
      base_url="$(grep -oE 'https://snapshots\.publicnode\.com/bitcoin-base[^"]*\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
    if [[ -z "$part_url" ]]; then
      part_url="$(grep -oE 'https://snapshots\.publicnode\.com/bitcoin-part-[0-9]+\.tar\.lz4' "$urls_file" | head -1 || true)"
    fi
  fi

  if [[ -z "$base_url" || -z "$part_url" ]]; then
    echo "ERROR: Could not resolve Bitcoin snapshot URLs." >&2
    echo "  base : ${base_url:-<not found>}" >&2
    echo "  part : ${part_url:-<not found>}" >&2
    echo "Update bitcoin/snapshot-urls.txt with current publicnode.com URLs." >&2
    exit 1
  fi

  echo "==> Resolved URLs:"
  echo "    base : $base_url"
  echo "    part : $part_url"

  mkdir -p "$dest"

  download "$base_url" "$dest"
  download "$part_url" "$dest"

  # Resolve actual filenames on disk
  local base_file part_file
  base_file="$(ls -t "${dest}"/bitcoin-base*.tar.lz4 2>/dev/null | head -1)"
  part_file="$(ls -t "${dest}"/bitcoin-part-*.tar.lz4 2>/dev/null | head -1)"

  if [[ -z "$base_file" || -z "$part_file" ]]; then
    echo "ERROR: Could not find all downloaded snapshot files in $dest" >&2
    echo "  base : ${base_file:-<not found>}" >&2
    echo "  part : ${part_file:-<not found>}" >&2
    exit 1
  fi

  echo "==> Extracting base snapshot ..."
  extract_lz4 "$base_file" "$dest"

  echo "==> Extracting incremental snapshot ..."
  extract_lz4 "$part_file" "$dest"

  fix_ownership "$dest"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────
echo "=== download-snapshot: node=${NODE} type=${TYPE} extract_only=${EXTRACT_ONLY} data_root=${DATA_ROOT} ==="

case "$NODE" in
  eth)     do_eth ;;
  arb)     do_arb ;;
  base)    do_base ;;
  polygon) do_polygon ;;
  bsc)     do_bsc ;;
  tron)    do_tron ;;
  bitcoin) do_bitcoin ;;
esac

echo "=== Done ==="
