# Hyperliquid node lag watchdog. Checks every 5 min whether our hl-node has
# fallen behind chain head; if so, restarts the container.
# Install with:
#   sudo install -o root -g root -m 644 hyperliquid/hl-lag-watchdog.cron \
#       /etc/cron.d/hl-lag-watchdog
#
# Uses TZ=UTC so the schedule is unambiguous regardless of host timezone.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=UTC

*/5 * * * * mvp /home/mvp/Running/RPC_nodes/hyperliquid/lag-watchdog.sh
